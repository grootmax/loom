# Race: Check-then-act on a Mutex split across two lock calls.

use std.sync.Mutex

def main
  balance = Mutex.new(1)
  scope do |s|
    s.spawn do
      has_funds = balance.lock { |b| b > 0 }
      yield_now()
      if has_funds
        balance.lock { |mut b| b -= 1 }
      end
    end
    s.spawn do
      has_funds = balance.lock { |b| b > 0 }
      yield_now()
      if has_funds
        balance.lock { |mut b| b -= 1 }
      end
    end
  end
  puts balance.lock { |b| b }
end
