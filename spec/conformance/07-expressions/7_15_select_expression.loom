# spec: §11.3
def main
  ch = Chan[Int].new(capacity: 1)
  ch.send(42)
  select
  when Some(v) = ch.recv then puts v
  else puts 0
  end
  select
  when Some(v) = ch.recv then puts v
  else puts "empty"
  end
  ch.close
  select
  when result = ch.recv then puts "closed: #{result.is_none}"
  end
end
