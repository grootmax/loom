{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": ["loom"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#block-params" },
    { "include": "#fields" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.loom", "match": "##!?.*$" },
        { "name": "comment.line.number-sign.loom", "match": "#(?!\\{).*$" }
      ]
    },
    "attributes": {
      "name": "meta.attribute.loom",
      "begin": "@\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.attribute.loom" } },
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.loom" } },
      "patterns": [
        { "name": "entity.name.function.attribute.loom", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" },
        { "include": "#types" },
        { "include": "#strings" },
        { "include": "#numbers" }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.loom",
      "match": "\\\\(n|r|t|0|\\\\|\"|'|#|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|$)"
    },
    "interpolation": {
      "name": "meta.interpolation.loom",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.loom" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.loom" } },
      "patterns": [{ "include": "#interpolation-body" }]
    },
    "interpolation-body": {
      "patterns": [
        { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#interpolation-body" }] },
        { "include": "$self" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.loom",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.other.raw.loom",
          "begin": "\\b(b?r)(#*)\"",
          "end": "\"\\2",
          "beginCaptures": { "1": { "name": "storage.type.string.loom" } }
        },
        {
          "name": "string.quoted.double.byte.loom",
          "begin": "\\b(b)\"",
          "end": "\"",
          "beginCaptures": { "1": { "name": "storage.type.string.loom" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.double.loom",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.char.loom",
      "match": "'(?:[^'\\\\\\n]|\\\\(?:n|r|t|0|\\\\|\"|'|#|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}))'"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.loom", "match": "\\b0x[0-9A-Fa-f](_?[0-9A-Fa-f])*\\b" },
        { "name": "constant.numeric.octal.loom", "match": "\\b0o[0-7](_?[0-7])*\\b" },
        { "name": "constant.numeric.binary.loom", "match": "\\b0b[01](_?[01])*\\b" },
        { "name": "constant.numeric.float.loom", "match": "\\b[0-9](_?[0-9])*\\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?\\b" },
        { "name": "constant.numeric.float.loom", "match": "\\b[0-9](_?[0-9])*[eE][+-]?[0-9](_?[0-9])*\\b" },
        { "name": "constant.numeric.integer.loom", "match": "\\b[0-9](_?[0-9])*\\b" }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(def)\\s+(?:(mut|own)\\s+)?(?:(self)\\.)?([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.loom" },
            "2": { "name": "storage.modifier.loom" },
            "3": { "name": "variable.language.self.loom" },
            "4": { "name": "entity.name.function.loom" }
          }
        },
        {
          "match": "\\b(struct|enum|trait|module|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.loom" },
            "2": { "name": "entity.name.type.loom" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.loom", "match": "\\b(if|elsif|else|then|case|in|when|select|while|for|loop|break|next|return|do|end)\\b" },
        { "name": "keyword.operator.logical.loom", "match": "\\b(and|or|not)\\b" },
        { "name": "keyword.other.loom", "match": "\\b(def|struct|enum|trait|impl|module|use|as|const|type|extern|unsafe|where|dyn|ref|default)\\b" },
        { "name": "storage.modifier.loom", "match": "\\b(pub|var|mut|own|package)\\b" },
        { "name": "constant.language.boolean.loom", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.self.loom", "match": "\\b(self|Self|super)\\b" },
        { "name": "support.function.builtin.loom", "match": "\\b(puts|print|panic|assert|assert_eq|scope)\\b" }
      ]
    },
    "block-params": {
      "match": "(?<=\\{|\\bdo)\\s*(\\|)([^|]*)(\\|)",
      "captures": {
        "1": { "name": "punctuation.definition.parameters.loom" },
        "2": { "name": "variable.parameter.loom" },
        "3": { "name": "punctuation.definition.parameters.loom" }
      }
    },
    "fields": {
      "name": "variable.other.readwrite.instance.loom",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.loom", "match": "\\b(Int|I8|I16|I32|I64|I128|U8|U16|U32|U64|U128|ISize|USize|Float|F32|F64|Bool|Char|String|Bytes|Unit|Never)\\b" },
        { "name": "support.type.builtin.loom", "match": "\\b(Array|Map|Set|Option|Result|Chan|Shared|Mutex|Fn|FnMut|FnOnce)\\b" },
        { "name": "support.constant.variant.loom", "match": "\\b(Some|None|Ok|Err)\\b" },
        { "name": "constant.other.loom", "match": "\\b[A-Z][A-Z0-9_]+\\b" },
        { "name": "entity.name.type.loom", "match": "\\b[A-Z][A-Za-z0-9]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.loom" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.loom", "match": "->|=>" },
        { "name": "keyword.operator.range.loom", "match": "\\.\\.=?" },
        { "name": "keyword.operator.try.loom", "match": "\\?" },
        { "name": "keyword.operator.comparison.loom", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.loom", "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)?=" },
        { "name": "keyword.operator.arithmetic.loom", "match": "\\+|-|\\*|/|%|&|\\||\\^|~|<<|>>" }
      ]
    }
  }
}
