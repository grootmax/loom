@[test]
def prelude_types_and_functions_available
  var arr: Array[Int] = Array.new
  arr.push(10)
  assert_eq(arr.length, 1)
  assert_eq(arr.get(0), Some(10))

  var m: Map[String, Int] = Map.new
  m.insert("a", 1)
  assert(m.has_key("a"))

  var s: Set[String] = Set.new
  s.insert("item")
  assert(s.contains("item"))

  var opt: Option[Int] = Some(100)
  assert_eq(opt.unwrap_or(0), 100)

  var res: Result[Int, String] = Ok(200)
  assert_eq(res.unwrap_or(0), 200)

  assert_eq((1..=3).sum, 6)
  assert_eq(Ordering.Less.reverse, Ordering.Greater)

  assert(true)
  assert_eq(1, 1)
end
