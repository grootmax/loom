@[test]
def string_new_is_empty
  var s = String.new
  assert_eq(s.length, 0)
  assert_eq(s.byte_length, 0)
  assert(s.is_empty)
end

@[test]
def string_length_and_byte_length_ascii
  var s = "hello"
  assert_eq(s.length, 5)
  assert_eq(s.byte_length, 5)
  assert(not s.is_empty)
end

@[test]
def string_length_and_byte_length_unicode
  var s = "λ"
  assert_eq(s.length, 1)
  assert_eq(s.byte_length, 2)
end

@[test]
def string_chars_returns_array_of_chars
  var s = "abc"
  var cs = s.chars
  assert_eq(cs.length, 3)
  assert_eq(cs.get(0), Some('a'))
  assert_eq(cs.get(1), Some('b'))
  assert_eq(cs.get(2), Some('c'))
end

@[test]
def string_push_str_appends_text
  var s = "hello"
  s.push_str(" world")
  assert_eq(s, "hello world")
end

@[test]
def string_push_str_empty
  var s = "hello"
  s.push_str("")
  assert_eq(s, "hello")
end

@[test]
def string_push_appends_single_char
  var s = "hi"
  s.push('!')
  assert_eq(s, "hi!")
end

@[test]
def string_to_uppercase_and_lowercase
  var s = "Hello World"
  assert_eq(s.to_uppercase, "HELLO WORLD")
  assert_eq(s.to_lowercase, "hello world")
end

@[test]
def string_trim_variants
  var s = "  hello world  "
  assert_eq(s.trim, "hello world")
  assert_eq(s.trim_start, "hello world  ")
  assert_eq(s.trim_end, "  hello world")
end

@[test]
def string_trim_empty_string
  var s = ""
  assert_eq(s.trim, "")
  assert_eq(s.trim_start, "")
  assert_eq(s.trim_end, "")
end

@[test]
def string_trim_matches_with_predicate
  var s = "123hello456"
  var trimmed = s.trim_matches { |c| c.is_digit }
  assert_eq(trimmed, "hello")
end

@[test]
def string_split_whitespace
  var s = "  one   two  three  "
  var parts = s.split_whitespace
  assert_eq(parts.length, 3)
  assert_eq(parts.get(0), Some("one"))
  assert_eq(parts.get(1), Some("two"))
  assert_eq(parts.get(2), Some("three"))
end

@[test]
def string_split_whitespace_only_spaces
  var s = "    "
  assert_eq(s.split_whitespace.length, 0)
end

@[test]
def string_split_by_separator
  var s = "apple,banana,cherry"
  var parts = s.split(",")
  assert_eq(parts.length, 3)
  assert_eq(parts.get(0), Some("apple"))
  assert_eq(parts.get(1), Some("banana"))
  assert_eq(parts.get(2), Some("cherry"))
end

@[test]
def string_split_empty_and_no_match
  var s = "hello"
  var parts = s.split(",")
  assert_eq(parts.length, 1)
  assert_eq(parts.get(0), Some("hello"))
end

@[test]
def string_contains_and_find
  var s = "hello world"
  assert(s.contains("world"))
  assert(not s.contains("xyz"))
  assert_eq(s.find("world"), Some(6))
  assert_eq(s.find("missing"), None)
end

@[test]
def string_contains_and_find_empty_pattern
  var s = "hello"
  assert(s.contains(""))
  assert_eq(s.find(""), Some(0))
end

@[test]
def string_starts_with_and_ends_with
  var s = "filename.loom"
  assert(s.starts_with("file"))
  assert(s.ends_with(".loom"))
  assert(not s.starts_with("name"))
  assert(not s.ends_with(".txt"))
end

@[test]
def string_starts_with_and_ends_with_empty
  var s = "hello"
  assert(s.starts_with(""))
  assert(s.ends_with(""))
end

@[test]
def string_starts_with_longer_prefix
  var s = "hi"
  assert(not s.starts_with("hello"))
  assert(not s.ends_with("hello"))
end

@[test]
def string_substring_valid_range
  var s = "abcdef"
  assert_eq(s.substring(1, 4), "bcd")
  assert_eq(s.substring(0, 6), "abcdef")
  assert_eq(s.substring(2, 2), "")
end

@[test]
def string_repeat_count
  var s = "abc"
  assert_eq(s.repeat(3), "abcabcabc")
  assert_eq(s.repeat(1), "abc")
  assert_eq(s.repeat(0), "")
end

@[test]
def string_clone_and_to_string
  var s = "original"
  var c = s.clone
  assert_eq(c, "original")
  assert_eq(s.to_string, "original")
end
