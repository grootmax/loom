trait Shape
  def area -> Float
  def name -> String
  default def describe -> String = "#{self.name} with area #{self.area.round(1)}"
end

@[derive(Clone, Eq)]
struct Circle
  radius: Float
end

struct Rect
  w: Float
  h: Float
end

impl Shape for Circle
  def area -> Float = Float.PI * @radius * @radius
  def name -> String = "circle"
end

impl Shape for Rect
  def area -> Float = @w * @h
  def name -> String = "rect"
end

struct Counter
  step: Int
  apply: Fn(Int) -> Int
end

def fib(n: Int) -> Int = if n < 2 then n else fib(n - 1) + fib(n - 2) end

def total_area(shapes: Array[dyn Shape]) -> Float
  var sum = 0.0
  for s in shapes
    sum += s.area
  end
  sum
end

def first_even[T: Clone](items: Array[T], key: Fn(T) -> Int) -> Option[T]
  for item in items
    if key(item) % 2 == 0
      return Some(item.clone)
    end
  end
  None
end

def main
  shapes: Array[dyn Shape] = [Circle(radius: 1.0), Rect(w: 2.0, h: 3.0)]
  for s in shapes
    puts s.describe
  end
  puts total_area(shapes).round(2)
  puts fib(20)
  c = Counter(step: 3, apply: { |x| x * 2 })
  puts((c.apply)(c.step))
  words = ["alpha", "beta", "gamma", "delta"]
  puts first_even(words) { |w| w.length }.unwrap_or("none")
  lengths = words.map { |w| w.length }
  puts lengths.join(",")
  puts((1..=10).filter { |n| n % 3 == 0 }.map { |n| n * n }.sum)
  var m = Map[String, Array[Int]].new
  m.insert("a", [1, 2])
  m.update("a", default: []) { |mut xs| xs.push(3) }
  m.update("b", default: [9]) { |mut xs| xs.push(10) }
  for (k, v) in m
    puts "#{k}: #{v.join(" ")}"
  end
  t = (1, "two", 3.0)
  puts "#{t.0} #{t.1} #{t.2}"
  puts Circle(radius: 2.0) == Circle(radius: 2.0)
  var sorted = [5, 3, 9, 1]
  sorted.sort
  puts sorted.join(" ")
  name = "Loom"
  puts name.chars.map { |ch| ch.to_uppercase.to_string }.join("-")
  puts Int.parse("42").unwrap + 1
  puts Int.parse("x").is_err
  r: Result[Int, String] = Err("bad")
  puts r.map { |v| v + 1 }.unwrap_or(-1)
  puts([3, 1, 2].max.unwrap)
  puts 10.pow(3)
  puts 7.checked_add(Int.max_value).is_none
  puts((-5).abs)
end
